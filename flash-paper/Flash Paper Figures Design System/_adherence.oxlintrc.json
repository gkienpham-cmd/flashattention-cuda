{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/figure/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigureFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|width|children|style|key|ref|className|style|children)$/]",
        "message": "<FigureFrame> doesn't accept that prop. Declared props: title, subtitle, width, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KernelChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:version|takeaway|status|phase|width|style|key|ref|className|style|children)$/]",
        "message": "<KernelChip> doesn't accept that prop. Declared props: version, takeaway, status, phase, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='KernelChip'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:landed|partial|missed|unmeasured)$/]",
        "message": "<KernelChip> status must be one of 'landed' | 'partial' | 'missed' | 'unmeasured'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KernelChip'] > JSXAttribute[name.name='phase'] > Literal[value!=/^(?:purple|blue|amber|green)$/]",
        "message": "<KernelChip> phase must be one of 'purple' | 'blue' | 'amber' | 'green'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:landed|partial|missed|unmeasured)$/]",
        "message": "<StatusDot> status must be one of 'landed' | 'partial' | 'missed' | 'unmeasured'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TintPanel'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|heading|subheading|dashed|children|style|key|ref|className|style|children)$/]",
        "message": "<TintPanel> doesn't accept that prop. Declared props: tone, heading, subheading, dashed, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TintPanel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|blue|green|amber|red|purple)$/]",
        "message": "<TintPanel> tone must be one of 'neutral' | 'blue' | 'green' | 'amber' | 'red' | 'purple'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Verdict'] > JSXAttribute > JSXIdentifier[name!=/^(?:yes|partial|children|style|key|ref|className|style|children)$/]",
        "message": "<Verdict> doesn't accept that prop. Declared props: yes, partial, children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "FigureFrame": {
        "replaces": []
      },
      "KernelChip": {
        "replaces": []
      },
      "StatusDot": {
